# Google Gemini API Key для автоматического извлечения ольфакторных нот
# Получите бесплатный ключ в Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Облачная база знаний, полки и краудсорсинг ароматов)
# Получите в консоли: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
